{
  "name": "dsh-theme-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wallpaper, header title, and header icon for the DSH Web GUI, with a sidebar entry and its own panel.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "wallpaper",
    "customization",
    "ui"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
